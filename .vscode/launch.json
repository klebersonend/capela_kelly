{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Iniciar Kelly Capela (F5)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/wsgi.py",
            "console": "integratedTerminal",
            "env": {
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1"
            },
            "justMyCode": false
        },
        {
            "name": "Python: Flask Module",
            "type": "python",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "wsgi.py",
                "FLASK_DEBUG": "1",
                "FLASK_ENV": "development"
            },
            "args": [
                "run",
                "--port",
                "5000"
            ],
            "jinja": true,
            "justMyCode": true
        }
    ]
}
